{
  "name": "dragonvein",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "A browser 3D creature-collector RPG where breeding generates real 3D dragons.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "npm run build && node tools/strip-sourcemaps.mjs",
    "preview": "vite preview --port 4173",

    "gates": "npm run build && npm run lint && npm run test && npm run check:layers && npm run check:determinism && npm run check:assets && npm run gate:parity && npm run gate:meshgen && npm run gate:perf && npm run gate:smoke",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tools tests --max-warnings 0",
    "test": "vitest run",

    "check:layers": "node tools/check-layers.mjs",
    "check:determinism": "node tools/check-determinism.mjs",
    "check:assets": "node tools/check-assets.mjs",
    "gate:parity": "node tools/gate-parity.mjs",
    "gate:meshgen": "node tools/gate-meshgen.mjs",
    "gate:perf": "node tools/gate-perf.mjs",
    "gate:smoke": "node tools/playtest.mjs",

    "assets:build": "python3 assetgen/build_all.py",
    "assets:render": "python3 assetgen/render_all.py",
    "assets:compress": "gltf-transform optimize public/assets --texture-compress webp"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.2.1",
    "@types/three": "0.186.0",
    "eslint": "9.37.0",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vite": "7.1.9",
    "vitest": "3.2.4"
  },
  "engines": { "node": ">=20" }
}
